doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title TechRetail Solutions — #{titulo}
    script(src="https://cdn.tailwindcss.com")
  body(class="bg-gray-100 text-gray-800 font-sans")

    header(class="bg-blue-900 text-white px-8 py-4 flex items-center gap-4")
      h1(class="text-xl font-bold") TechRetail Solutions S.R.L.
      span(class="text-sm opacity-60") Plataforma SaaS de E-Commerce

    nav(class="bg-blue-800 px-8 py-2 flex items-center justify-between gap-6")
      div(class="flex gap-6")
        a(href="/" class="text-blue-200 hover:text-white text-sm transition-colors") Inicio
        
        if usuarioLogueado
          if usuarioLogueado.rol === 'admin'
            a(href="/planes/vista" class="text-blue-200 hover:text-white text-sm transition-colors") Planes
            a(href="/usuarios/vista" class="text-blue-200 hover:text-white text-sm transition-colors") Usuarios
          a(href="/api/planes" class="text-blue-200 hover:text-white text-sm transition-colors") API Productos
          a(href="/api/usuarios" class="text-blue-200 hover:text-white text-sm transition-colors") API Usuarios

      div(class="flex items-center gap-4")
        if usuarioLogueado
          span(class="text-blue-100 text-sm")
            span(class="font-semibold") #{usuarioLogueado.nombre}
            span(class="text-xs opacity-70 ml-2") (#{usuarioLogueado.rol})
          
          form(action="/logout" method="POST" style="display:inline")
            button(type="submit" class="bg-red-600 hover:bg-red-700 text-white text-sm px-3 py-1 rounded transition-colors") Cerrar sesion
        else
          a(href="/login" class="bg-green-600 hover:bg-green-700 text-white text-sm px-4 py-1 rounded transition-colors") Iniciar sesion

    main(class="max-w-6xl mx-auto px-8 py-8")
      block contenido

    footer(class="text-center text-gray-400 text-xs py-6 mt-10")
      p © 2025 TechRetail Solutions S.R.L. | Grupo 13 — Ingeniería de Software

    script(src="/socket.io/socket.io.js")
    script.
      const socket = io();

      function mostrarNotificacion(mensaje, tipo) {
        const colores = { plan: 'bg-blue-600', usuario: 'bg-green-600' };
        const notif = document.createElement('div');
        notif.className = 'fixed bottom-4 right-4 px-4 py-3 rounded-lg text-white text-sm font-semibold shadow-lg z-50 ' + (colores[tipo] || 'bg-gray-700');
        notif.textContent = mensaje;
        document.body.appendChild(notif);
        setTimeout(() => notif.remove(), 4000);
      }

      socket.on('nuevo-plan', function(data) {
        mostrarNotificacion('Nuevo plan: ' + data.nombre + ' ($' + data.precio.toLocaleString('es-AR') + ')', 'plan');
      });

      socket.on('nuevo-usuario', function(data) {
        mostrarNotificacion('Nuevo usuario: ' + data.nombre + ' (' + data.email + ')', 'usuario');
      });