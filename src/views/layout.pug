doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title TechRetail Solutions — #{titulo}
    script(src="https://cdn.tailwindcss.com")
    link(rel="manifest" href="/manifest.json")
    meta(name="theme-color" content="#1D4ED8")
    link(rel="apple-touch-icon" href="/icons/icon-192.png")
    script(src="/js/pwa.js")
  body(class="bg-gray-100 text-gray-800 font-sans")

    header(class="bg-blue-900 text-white px-8 py-4 flex items-center gap-4")
      h1(class="text-xl font-bold") TechRetail Solutions S.R.L.
      span(class="text-sm opacity-60") Plataforma SaaS de E-Commerce

    nav(class="bg-blue-800 px-8 py-2 flex items-center justify-between gap-6")
      div(class="flex gap-6")
        a(href="/" class="text-blue-200 hover:text-white text-sm transition-colors") Inicio
        
        if usuarioLogueado
          if usuarioLogueado.rol === 'admin'
            a(href="/planes/vista" class="text-blue-200 hover:text-white text-sm transition-colors") Planes
            a(href="/usuarios/vista" class="text-blue-200 hover:text-white text-sm transition-colors") Usuarios
            a(href="/finanzas" class="text-blue-200 hover:text-white text-sm transition-colors") Finanzas

      div(class="flex items-center gap-4")
        if usuarioLogueado
          span(class="text-blue-100 text-sm")
            span(class="font-semibold") #{usuarioLogueado.nombre}
            span(class="text-xs opacity-70 ml-2") (#{usuarioLogueado.rol})
          
          form(action="/logout" method="POST" style="display:inline")
            button(type="submit" class="bg-red-600 hover:bg-red-700 text-white text-sm px-3 py-1 rounded transition-colors") Cerrar sesión
        else
          a(href="/login" class="bg-green-600 hover:bg-green-700 text-white text-sm px-4 py-1 rounded transition-colors") Iniciar sesión

    main(class="max-w-6xl mx-auto px-8 py-8")
      if flash
        - const esError = flash.tipo === 'error'
        div(class="mb-6 rounded-lg border px-4 py-3 text-sm font-semibold " + (esError ? 'border-red-200 bg-red-50 text-red-700' : 'border-green-200 bg-green-50 text-green-700'))
          | #{flash.mensaje}
      block contenido

    footer(class="text-center text-gray-400 text-xs py-6 mt-10")
      p © 2025 TechRetail Solutions S.R.L.

    script(src="/js/validacion.js")
    script(src="/socket.io/socket.io.js")
    script.
      const socket = io();

      function mostrarNotificacion(mensaje, tipo) {
        const colores = {
          plan: 'bg-blue-600',
          usuario: 'bg-green-600',
          tienda: 'bg-teal-600',
          publicada: 'bg-emerald-600',
          producto: 'bg-indigo-600',
          pedido: 'bg-purple-600'
        };
        const notif = document.createElement('div');
        notif.className = 'fixed bottom-4 right-4 px-4 py-3 rounded-lg text-white text-sm font-semibold shadow-lg z-50 ' + (colores[tipo] || 'bg-gray-700');
        notif.textContent = mensaje;
        document.body.appendChild(notif);
        setTimeout(() => notif.remove(), 4000);
      }

      // Refresca el panel para reflejar los datos nuevos, salvo que el admin
      // esté escribiendo en un campo (para no perder un formulario en progreso).
      function refrescarPanel() {
        const activo = document.activeElement;
        const escribiendo = activo && ['INPUT', 'TEXTAREA', 'SELECT'].includes(activo.tagName);
        if (escribiendo) return;
        setTimeout(() => window.location.reload(), 1500);
      }

      socket.on('nuevo-plan', function(data) {
        mostrarNotificacion('Nuevo plan: ' + data.nombre + ' ($' + data.precio.toLocaleString('es-AR') + ')', 'plan');
        refrescarPanel();
      });

      socket.on('nuevo-usuario', function(data) {
        mostrarNotificacion('Nuevo usuario: ' + data.nombre + ' (' + data.email + ')', 'usuario');
        refrescarPanel();
      });

      socket.on('plan-seleccionado', function(data) {
        const estado = data.enTrial ? 'prueba gratuita' : 'plan pago';
        mostrarNotificacion(data.usuario + ' eligió ' + data.plan + ' (' + estado + ')', 'plan');
        refrescarPanel();
      });

      socket.on('nueva-tienda', function(data) {
        mostrarNotificacion('Nueva tienda: ' + data.nombre + ' (' + data.rubro + ')', 'tienda');
        refrescarPanel();
      });

      socket.on('tienda-publicada', function(data) {
        mostrarNotificacion('Tienda publicada: ' + data.nombre + ' por ' + data.usuario, 'publicada');
        refrescarPanel();
      });

      socket.on('nuevo-producto', function(data) {
        mostrarNotificacion('Nuevo producto: ' + data.nombre + ' en ' + data.tienda, 'producto');
        refrescarPanel();
      });

      socket.on('nuevo-pedido', function(data) {
        mostrarNotificacion('Nuevo pedido en ' + data.tienda + ' ($' + data.total.toLocaleString('es-AR') + ')', 'pedido');
        refrescarPanel();
      });
