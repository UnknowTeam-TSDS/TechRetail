extends layout

block contenido
  h2(class="text-2xl font-bold text-blue-900 mb-1") Panel de Administración
  p(class="text-gray-400 text-sm mb-8") TechRetail Solutions S.R.L. — Resumen general de la plataforma

  if stats

    // ── Métricas de clientes ─────────────────────────────────────────────────
    p(class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-2") Clientes
    div(class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6")

      div(class="bg-white rounded-xl shadow-md p-5")
        p(class="text-xs text-gray-500 uppercase tracking-wide mb-1") Total clientes
        p(class="text-3xl font-bold text-blue-900") #{stats.totalClientes}
        p(class="text-xs text-gray-400 mt-1") registrados en la plataforma

      div(class="bg-white rounded-xl shadow-md p-5")
        p(class="text-xs text-gray-500 uppercase tracking-wide mb-1") Clientes activos
        p(class="text-3xl font-bold text-green-600") #{stats.activos}
        p(class="text-xs text-gray-400 mt-1")
          | #{stats.inactivos} inactivos · #{stats.suspendidos} suspendidos

      div(class="bg-white rounded-xl shadow-md p-5")
        p(class="text-xs text-gray-500 uppercase tracking-wide mb-1") En trial activo
        p(class="text-3xl font-bold text-green-500") #{stats.enTrial}
        p(class="text-xs text-gray-400 mt-1") usuarios en prueba gratuita

      div(class="bg-white rounded-xl shadow-md p-5")
        p(class="text-xs text-gray-500 uppercase tracking-wide mb-1") MRR estimado
        p(class="text-3xl font-bold text-blue-700")
          | $#{stats.mrr.toLocaleString('es-AR')}
        p(class="text-xs text-gray-400 mt-1") ingresos mensuales recurrentes (ARS)

    // ── Métricas de catálogo y contenido ─────────────────────────────────────
    p(class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-2") Catálogo y contenido
    div(class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6")

      div(class="bg-white rounded-xl shadow-md p-5")
        p(class="text-xs text-gray-500 uppercase tracking-wide mb-1") Catálogo
        p(class="text-3xl font-bold text-purple-700") #{stats.totalPlanes}
        p(class="text-xs text-gray-400 mt-1") planes · #{stats.totalAddons} add-ons
        p(class="text-xs text-indigo-500 font-semibold mt-1") #{stats.addonsContratados} add-ons contratados

      div(class="bg-white rounded-xl shadow-md p-5")
        p(class="text-xs text-gray-500 uppercase tracking-wide mb-1") Tiendas
        p(class="text-3xl font-bold text-teal-600") #{stats.totalTiendas}
        div(class="flex flex-wrap gap-2 mt-2")
          span(class="text-xs bg-emerald-100 text-emerald-700 font-semibold px-2 py-0.5 rounded-full") #{stats.tiendasPublicadas} publicadas
          span(class="text-xs bg-amber-100 text-amber-700 font-semibold px-2 py-0.5 rounded-full") #{stats.tiendasBorrador} en borrador
        if stats.tiendasInactivas > 0
          p(class="text-xs text-gray-400 mt-1") #{stats.tiendasInactivas} inactivas

      div(class="bg-white rounded-xl shadow-md p-5")
        p(class="text-xs text-gray-500 uppercase tracking-wide mb-1") Productos
        p(class="text-3xl font-bold text-cyan-600") #{stats.totalProductos}
        p(class="text-xs text-gray-400 mt-1") productos cargados

      div(class="bg-white rounded-xl shadow-md p-5")
        p(class="text-xs text-gray-500 uppercase tracking-wide mb-1") Pedidos
        p(class="text-3xl font-bold text-purple-600") #{stats.totalPedidos}
        p(class="text-xs text-gray-400 mt-1") compras simuladas

    // ── Fila 2: distribución + accesos rápidos ───────────────────────────────
    div(class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6")

      div(class="bg-white rounded-xl shadow-md p-5")
        h3(class="text-sm font-semibold text-gray-700 mb-4") Clientes por plan
        if Object.keys(distribucion).length === 0
          p(class="text-gray-400 text-sm") No hay clientes registrados aún.
        else
          each cantidad, nombre in distribucion
            div(class="flex items-center justify-between mb-3")
              span(class="text-sm text-gray-700") #{nombre}
              div(class="flex items-center gap-2")
                div(class=(nombre === 'Prueba gratuita' ? 'h-2 rounded-full bg-amber-400' : 'h-2 rounded-full bg-blue-500') style=`width:${Math.max(cantidad * 24, 8)}px`)
                span(class="text-sm font-semibold text-gray-800") #{cantidad}

      div(class="bg-white rounded-xl shadow-md p-5")
        h3(class="text-sm font-semibold text-gray-700 mb-4") Estado de clientes
        div(class="space-y-3")
          div(class="flex items-center justify-between")
            div(class="flex items-center gap-2")
              span(class="w-3 h-3 rounded-full bg-green-500 inline-block")
              span(class="text-sm text-gray-700") Activos
            span(class="font-bold text-green-600") #{stats.activos}
          div(class="flex items-center justify-between")
            div(class="flex items-center gap-2")
              span(class="w-3 h-3 rounded-full bg-red-400 inline-block")
              span(class="text-sm text-gray-700") Inactivos
            span(class="font-bold text-red-500") #{stats.inactivos}
          div(class="flex items-center justify-between")
            div(class="flex items-center gap-2")
              span(class="w-3 h-3 rounded-full bg-yellow-400 inline-block")
              span(class="text-sm text-gray-700") Suspendidos
            span(class="font-bold text-yellow-500") #{stats.suspendidos}
        div(class="mt-5 pt-4 border-t border-gray-100 flex gap-3")
          a(href="/planes/vista" class="flex-1 text-center bg-blue-900 text-white text-xs font-semibold py-2 rounded-lg hover:bg-blue-800 transition-colors") Ver planes
          a(href="/usuarios/vista" class="flex-1 text-center bg-blue-100 text-blue-900 text-xs font-semibold py-2 rounded-lg hover:bg-blue-200 transition-colors") Ver usuarios

    // ── Alertas de churn (RF-02): clientes en riesgo de baja ─────────────────
    div(class="bg-white rounded-xl shadow-md p-5 mb-6 border-l-4 " + ((enRiesgo && enRiesgo.length > 0) ? 'border-red-400' : 'border-green-400'))
      div(class="flex items-center justify-between mb-4")
        h3(class="text-sm font-semibold text-gray-700") Clientes en riesgo (churn)
        if enRiesgo && enRiesgo.length > 0
          span(class="bg-red-100 text-red-700 text-xs font-bold px-2.5 py-0.5 rounded-full") #{enRiesgo.length}
      if !enRiesgo || enRiesgo.length === 0
        p(class="text-sm text-gray-400") Sin clientes en riesgo. Todos activos y al día. ✓
      else
        div(class="space-y-2")
          each cliente in enRiesgo
            div(class="flex items-center justify-between gap-3 border border-gray-100 rounded-lg px-3 py-2")
              div(class="min-w-0")
                p(class="text-sm font-semibold text-gray-800 truncate") #{cliente.nombre}
                p(class="text-xs text-gray-400 truncate") #{cliente.email}
              -
                var colorMotivo = cliente.motivo === 'Suspendido'
                  ? 'bg-yellow-100 text-yellow-700'
                  : (cliente.motivo === 'Inactivo' ? 'bg-red-100 text-red-600'
                  : (cliente.motivo === 'Prueba vencida' ? 'bg-amber-100 text-amber-700' : 'bg-gray-100 text-gray-600'));
              span(class="shrink-0 text-xs font-bold px-2.5 py-1 rounded-full " + colorMotivo) #{cliente.motivo}
        div(class="mt-4 pt-3 border-t border-gray-100")
          a(href="/usuarios/vista" class="text-xs font-semibold text-blue-700 hover:text-blue-900") Gestionar clientes →

    // ── Fila 3: últimos registros ────────────────────────────────────────────
    div(class="bg-white rounded-xl shadow-md p-5")
      h3(class="text-sm font-semibold text-gray-700 mb-4") Últimos clientes registrados
      if recientes.length === 0
        p(class="text-gray-400 text-sm") No hay clientes registrados aún.
      else
        table(class="w-full text-sm")
          thead
            tr(class="border-b border-gray-100")
              th(class="text-left text-xs text-gray-400 font-medium pb-2") Nombre
              th(class="text-left text-xs text-gray-400 font-medium pb-2") Email
              th(class="text-left text-xs text-gray-400 font-medium pb-2") Plan
              th(class="text-left text-xs text-gray-400 font-medium pb-2") Estado
              th(class="text-left text-xs text-gray-400 font-medium pb-2") Fecha
          tbody
            each u in recientes
              tr(class="border-b border-gray-50 hover:bg-gray-50")
                td(class="py-2 font-medium text-gray-800") #{u.nombre}
                td(class="py-2 text-gray-500") #{u.email}
                td(class="py-2")
                  - const enTrialU = u.trialHasta && new Date(u.trialHasta) > new Date()
                  if enTrialU
                    span(class="bg-amber-100 text-amber-700 text-xs px-2 py-0.5 rounded-full") Prueba gratuita
                  else if u.planId
                    span(class="bg-blue-100 text-blue-800 text-xs px-2 py-0.5 rounded-full") #{u.planId.nombre}
                  else
                    span(class="text-gray-300 text-xs") Sin plan
                td(class="py-2")
                  if u.estado === 'activo'
                    span(class="text-green-600 font-medium") Activo
                  else if u.estado === 'suspendido'
                    span(class="text-yellow-500 font-medium") Suspendido
                  else
                    span(class="text-red-400 font-medium") Inactivo
                td(class="py-2 text-gray-400") #{new Date(u.fechaRegistro).toLocaleDateString('es-AR')}

  else
    p(class="text-gray-400") Error al cargar las métricas.
