        {
          "name": "2. Login Admin (Exitoso)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 302 (redirect)\", function () {",
                  "    pm.response.to.have.status(302);",
                  "});",
                  "",
                  "pm.test(\"Redirige a /planes/vista (admin)\", function () {",
                  "    pm.expect(pm.response.headers.get(\"location\")).to.include(\"/planes/vista\");",
                  "});",
                  "",
                  "pm.test(\"Se crea cookie de sesión\", function () {",
                  "    pm.expect(pm.response.headers.has(\"Set-Cookie\")).to.be.true;",
                  "});",
                  "",
                  "// Guardamos la cookie del header para usarla en los siguientes requests",
                  "var setCookie = pm.response.headers.get(\"Set-Cookie\");",
                  "if (setCookie) {",
                  "    var match = setCookie.match(/connect\\.sid=([^;]+)/);",
                  "    if (match) {",
                  "        pm.environment.set(\"sessionCookie\", \"connect.sid=\" + match[1]);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
