doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title TechRetail Solutions — Iniciar Sesión
    script(src="https://cdn.tailwindcss.com")
  body(class="bg-gradient-to-br from-blue-900 to-blue-700 min-h-screen flex items-center justify-center font-sans")

    div(class="w-full max-w-md")
      // Card principal
      div(class="bg-white rounded-lg shadow-2xl p-8")
        // Header
        div(class="text-center mb-8")
          h1(class="text-3xl font-bold text-blue-900") TechRetail
          p(class="text-gray-600 text-sm mt-1") Plataforma SaaS de E-Commerce

        // Mostrar error si existe
        if error
          div(class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6")
            p(class="font-semibold text-sm") ✗ Error
            p(class="text-xs mt-1") #{error}

        // Formulario
        form(action="/login" method="POST")
          // Email
          div(class="mb-4")
            label(class="block text-gray-700 font-semibold text-sm mb-2") Email
            input(type="email" name="email" required class="w-full border-2 border-gray-300 rounded-lg px-4 py-2 text-sm focus:outline-none focus:border-blue-900 transition-colors" placeholder="tu@email.com")

          // Contraseña
          div(class="mb-6")
            label(class="block text-gray-700 font-semibold text-sm mb-2") Contraseña
            input(type="password" name="contrasena" required class="w-full border-2 border-gray-300 rounded-lg px-4 py-2 text-sm focus:outline-none focus:border-blue-900 transition-colors" placeholder="Tu contraseña")

          // Botón
          button(type="submit" class="w-full bg-blue-900 text-white font-bold py-2 rounded-lg hover:bg-blue-800 transition-colors text-sm") Iniciar Sesión

        // Separador
        div(class="mt-8 pt-6 border-t border-gray-300")
          p(class="text-gray-600 text-xs text-center font-semibold mb-3") 📝 CREDENCIALES DE PRUEBA

        // Datos de prueba
        div(class="bg-blue-50 rounded-lg p-4 text-xs text-gray-700 space-y-2")
          div
            p(class="font-bold text-blue-900") Admin:
            p(class="text-gray-600") admin@techretail.com
            p(class="text-gray-600") 123456

        // Footer
        div(class="mt-8 pt-6 border-t border-gray-300 text-center")
          p(class="text-gray-400 text-xs")
            | © 2025 TechRetail Solutions S.R.L.
            br