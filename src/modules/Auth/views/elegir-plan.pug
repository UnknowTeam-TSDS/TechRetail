doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title TechRetail Solutions — Elegir plan
    script(src="https://cdn.tailwindcss.com")
  body(class="bg-gradient-to-br from-blue-900 to-blue-700 min-h-screen font-sans py-10 px-4")

    div(class="max-w-5xl mx-auto")

      div(class="text-center mb-10")
        h1(class="text-3xl font-bold text-white")
          if planActualId
            | Cambiar plan
          else
            | Elegí tu plan
        p(class="text-blue-200 mt-2") #{usuario.nombre} — TechRetail Solutions

      div(class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10")

        each plan in planes
          - const esMiPlan = !!(planActualId && String(plan._id) === String(planActualId))
          - const esStarter = plan.nombre.toLowerCase() === 'starter'
          - const cardBorder = esMiPlan ? 'border-2 border-blue-400' : esStarter ? 'border-2 border-green-400' : 'border border-white/20'
          - const cardClass = 'bg-white rounded-2xl shadow-2xl overflow-hidden relative ' + cardBorder
          - const headerBg = esMiPlan ? 'bg-blue-700' : esStarter ? 'bg-green-500' : 'bg-blue-800'
          - const headerClass = headerBg + ' text-white px-6 py-5'

          div(class=cardClass)

            if esMiPlan
              div(class="absolute top-3 right-3 bg-blue-600 text-white text-xs font-bold px-3 py-1 rounded-full") Tu plan actual
            if esStarter && !planActualId
              div(class="absolute top-3 right-3 bg-green-100 text-green-800 text-xs font-bold px-3 py-1 rounded-full") GRATIS 14 días

            div(class=headerClass)
              h2(class="text-xl font-bold") #{plan.nombre}
              if esStarter
                p(class="text-sm mt-1 opacity-80") Perfecto para empezar
              else if plan.nombre.toLowerCase() === 'growth'
                p(class="text-sm mt-1 opacity-80") Para negocios en crecimiento
              else
                p(class="text-sm mt-1 opacity-80") Para empresas consolidadas

            div(class="p-6")

              if esMiPlan && enTrial
                div(class="mb-2")
                  span(class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded-full font-bold") Período de prueba activo
                p(class="text-3xl font-extrabold text-blue-900 mt-2") #{diasTrial} días restantes
                p(class="text-sm text-gray-500 mt-1") Al vencer: $#{plan.precio.toLocaleString('es-AR')}/mes
              else if esMiPlan
                p(class="text-4xl font-extrabold text-blue-900")
                  | $#{plan.precio.toLocaleString('es-AR')}
                  span(class="text-sm font-normal text-gray-400") /mes
                p(class="text-xs text-blue-600 font-semibold mt-2") Plan activo
              else if esStarter && !planActualId
                p(class="text-4xl font-extrabold text-green-600") GRATIS
                p(class="text-sm text-gray-500 mt-1") por 14 días, luego $#{plan.precio.toLocaleString('es-AR')}/mes
                p(class="text-xs text-green-700 font-semibold mt-2") Sin tarjeta requerida
              else
                p(class="text-4xl font-extrabold text-blue-900")
                  | $#{plan.precio.toLocaleString('es-AR')}
                  span(class="text-sm font-normal text-gray-400") /mes (ARS)

              ul(class="mt-4 space-y-2 text-sm text-gray-600 mb-6")
                if esStarter
                  li ✓ Hasta 100 productos
                  li ✓ 1 tienda online
                  li ✓ Soporte por email
                  li ✓ Panel de administración
                else if plan.nombre.toLowerCase() === 'growth'
                  li ✓ Hasta 1.000 productos
                  li ✓ 3 tiendas online
                  li ✓ Soporte prioritario
                  li ✓ Reportes avanzados
                  li ✓ Integraciones con marketplaces
                else
                  li ✓ Productos ilimitados
                  li ✓ Tiendas ilimitadas
                  li ✓ Soporte 24/7
                  li ✓ API personalizada
                  li ✓ Manager dedicado

              if esMiPlan
                a(href="/mi-cuenta" class="block w-full text-center bg-blue-100 hover:bg-blue-200 text-blue-900 font-bold py-3 rounded-xl text-sm transition-colors") Conservar plan actual
              else if esStarter && !planActualId
                form(action="/elegir-plan" method="POST")
                  input(type="hidden" name="planId" value=String(plan._id))
                  button(type="submit" class="w-full bg-green-500 hover:bg-green-600 text-white font-bold py-3 rounded-xl text-sm transition-colors") Comenzar prueba gratuita
              else
                - const planIdStr = String(plan._id)
                - const planNombre = plan.nombre
                - const planPrecio = plan.precio
                button(
                  type="button"
                  data-plan-id=planIdStr
                  data-plan-nombre=planNombre
                  data-plan-precio=planPrecio
                  onclick="abrirPago(this)"
                  class="w-full bg-blue-900 hover:bg-blue-800 text-white font-bold py-3 rounded-xl text-sm transition-colors")
                  | Elegir #{plan.nombre} →

      div(class="text-center")
        if planActualId
          a(href="/mi-cuenta" class="text-blue-200 text-sm hover:text-white") ← Volver a mi cuenta
        form(action="/logout" method="POST" class="inline")
          button(type="submit" class="text-blue-200 text-sm hover:text-white underline ml-4") Cerrar sesión

    div(id="modal-pago" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50 px-4")
      div(class="bg-white rounded-2xl shadow-2xl p-8 max-w-md w-full")

        h3(class="text-xl font-bold text-blue-900 mb-1") Simulación de pago
        div(class="bg-amber-50 border border-amber-200 text-amber-800 text-xs px-3 py-2 rounded-lg mb-5")
          | Entorno de pruebas — no se realizará ningún cobro real

        div(class="bg-blue-50 rounded-xl p-4 mb-5")
          p(class="text-xs text-gray-500 uppercase font-semibold") Plan seleccionado
          p(id="modal-plan-nombre" class="text-lg font-bold text-blue-900 mt-1") —
          div(class="flex items-baseline gap-1 mt-1")
            p(id="modal-plan-precio" class="text-2xl font-extrabold text-blue-700") —
            span(class="text-xs text-gray-400") /mes (ARS)

        form(id="form-pago" action="/elegir-plan" method="POST" class="space-y-4")
          input(type="hidden" id="modal-plan-id" name="planId")

          div
            label(class="block text-sm font-semibold text-gray-700 mb-1") Nombre en la tarjeta
            input(type="text" placeholder="NOMBRE APELLIDO" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")

          div
            label(class="block text-sm font-semibold text-gray-700 mb-1") Número de tarjeta
            input(type="text" placeholder="•••• •••• •••• ••••" maxlength="19" required oninput="formatearTarjeta(this)" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")

          div(class="grid grid-cols-2 gap-3")
            div
              label(class="block text-sm font-semibold text-gray-700 mb-1") Vencimiento
              input(type="text" placeholder="MM/AA" maxlength="5" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")
            div
              label(class="block text-sm font-semibold text-gray-700 mb-1") CVV
              input(type="text" placeholder="•••" maxlength="3" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")

          div(class="flex gap-3 pt-2")
            button(type="button" onclick="cerrarModal()" class="flex-1 border border-gray-300 text-gray-600 font-semibold py-2.5 rounded-xl text-sm hover:bg-gray-50 transition-colors") Cancelar
            button(type="submit" class="flex-1 bg-blue-900 hover:bg-blue-800 text-white font-bold py-2.5 rounded-xl text-sm transition-colors") Confirmar pago

    script.
      function abrirPago(btn) {
        document.getElementById('modal-plan-id').value = btn.dataset.planId;
        document.getElementById('modal-plan-nombre').textContent = btn.dataset.planNombre;
        document.getElementById('modal-plan-precio').textContent =
          '$' + Number(btn.dataset.planPrecio).toLocaleString('es-AR');
        document.getElementById('modal-pago').classList.remove('hidden');
      }

      function cerrarModal() {
        document.getElementById('modal-pago').classList.add('hidden');
      }

      function formatearTarjeta(input) {
        var val = input.value.replace(/\D/g, '').substring(0, 16);
        input.value = val.replace(/(.{4})/g, '$1 ').trim();
      }

      document.getElementById('modal-pago').addEventListener('click', function(e) {
        if (e.target === this) cerrarModal();
      });
