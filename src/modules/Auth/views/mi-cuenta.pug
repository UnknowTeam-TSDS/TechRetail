doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title TechRetail Solutions — Mi cuenta
    script(src="https://cdn.tailwindcss.com")
  body(class="bg-gradient-to-br from-blue-900 to-blue-700 min-h-screen font-sans py-10 px-4")

    div(class="max-w-2xl mx-auto")

      div(class="text-center mb-6")
        h1(class="text-2xl font-bold text-white") TechRetail Solutions
        p(class="text-blue-200 text-sm") Panel del cliente

      div(class="bg-white rounded-2xl shadow-2xl p-8 mb-6")

        div(class="text-center mb-6")
          div(class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-3")
            span(class="text-3xl font-bold text-blue-900") #{usuario.nombre.charAt(0).toUpperCase()}
          h2(class="text-xl font-bold text-blue-900") #{usuario.nombre}
          p(class="text-gray-500 text-sm") #{usuario.email}

        div(class="bg-gray-50 rounded-xl p-5 mb-6")
          p(class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3") Mi plan actual

          if planActual
            if enTrial
              div(class="flex items-center gap-2 mb-2")
                span(class="bg-green-100 text-green-800 text-xs px-3 py-1 rounded-full font-bold") Período de prueba
                span(class="text-green-600 font-semibold text-sm") #{diasTrial} días restantes
              p(class="text-2xl font-extrabold text-blue-900") #{planActual.nombre}
              p(class="text-sm text-gray-500 mt-1")
                | Al vencer el trial: $#{planActual.precio.toLocaleString('es-AR')}/mes
              p(class="text-xs text-green-700 mt-2") Sin tarjeta requerida durante el período de prueba
            else
              p(class="text-2xl font-extrabold text-blue-900") #{planActual.nombre}
              p(class="text-3xl font-bold text-blue-700 mt-1")
                | $#{planActual.precio.toLocaleString('es-AR')}
                span(class="text-sm font-normal text-gray-400") /mes (ARS)
              div(class="mt-2")
                span(class="bg-blue-100 text-blue-800 text-xs px-3 py-1 rounded-full font-semibold") Plan activo
          else
            div(class="text-center py-4")
              p(class="text-gray-400 text-sm") No tenés un plan activo
              a(href="/elegir-plan" class="text-blue-700 font-semibold text-sm hover:underline") Elegir plan ahora

        div(class="space-y-3")
          a(href="/elegir-plan"
            class="block w-full text-center bg-blue-900 hover:bg-blue-800 text-white font-bold py-3 rounded-xl text-sm transition-colors")
            | Cambiar plan

          form(action="/logout" method="POST")
            button(type="submit"
              class="w-full text-gray-400 hover:text-red-500 text-sm py-2 transition-colors")
              | Cerrar sesión

      if (addonsContratados && addonsContratados.length > 0) || (addonsDisponibles && addonsDisponibles.length > 0)
        div(class="mb-2")
          h2(class="text-white font-bold text-lg") Add-ons

        div(class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6")

          each addon in addonsContratados
            - const contratado = true
            div(class="bg-white rounded-2xl shadow-2xl overflow-hidden border-2 border-indigo-400 relative")
              div(class="absolute top-3 right-3 bg-indigo-600 text-white text-xs font-bold px-3 py-1 rounded-full") Activo
              div(class="bg-indigo-700 text-white px-6 py-5")
                h3(class="text-xl font-bold") #{addon.nombre}
                p(class="text-sm mt-1 opacity-80") Módulo contratado
              div(class="p-6")
                p(class="text-3xl font-extrabold text-indigo-700")
                  | $#{addon.precio.toLocaleString('es-AR')}
                  span(class="text-sm font-normal text-gray-400") /mes
                span(class="inline-block mt-2 bg-indigo-100 text-indigo-800 text-xs px-3 py-1 rounded-full font-semibold") Suscripción activa
                form(action="/mis-addons/quitar" method="POST" class="mt-4")
                  input(type="hidden" name="addonId" value=String(addon._id))
                  button(type="submit" class="w-full border border-red-200 text-red-400 hover:bg-red-50 font-semibold py-2.5 rounded-xl text-sm transition-colors") Cancelar add-on

          each addon in addonsDisponibles
            div(class="bg-white rounded-2xl shadow-2xl overflow-hidden border border-white/20 relative")
              div(class="absolute top-3 right-3 bg-amber-100 text-amber-700 text-xs font-bold px-3 py-1 rounded-full") Próximamente
              div(class="bg-blue-800 text-white px-6 py-5")
                h3(class="text-xl font-bold") #{addon.nombre}
                p(class="text-sm mt-1 opacity-80") Módulo opcional
              div(class="p-6")
                p(class="text-3xl font-extrabold text-blue-900")
                  | $#{addon.precio.toLocaleString('es-AR')}
                  span(class="text-sm font-normal text-gray-400") /mes (ARS)
                p(class="text-sm text-gray-500 mt-3 leading-relaxed") #{addon.descripcion}
                button(
                  type="button"
                  disabled
                  class="w-full mt-5 bg-gray-200 text-gray-400 font-bold py-3 rounded-xl text-sm cursor-not-allowed")
                  | Contratar servicio

    p(class="text-center text-blue-200 text-xs mt-2 mb-6") © 2025 TechRetail Solutions S.R.L.

    div(id="modal-addon" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50 px-4")
      div(class="bg-white rounded-2xl shadow-2xl p-8 max-w-md w-full")

        h3(class="text-xl font-bold text-blue-900 mb-1") Contratar add-on
        div(class="bg-amber-50 border border-amber-200 text-amber-800 text-xs px-3 py-2 rounded-lg mb-5")
          | Entorno de pruebas — no se realizará ningún cobro real

        div(class="bg-indigo-50 rounded-xl p-4 mb-5")
          p(class="text-xs text-gray-500 uppercase font-semibold") Add-on seleccionado
          p(id="modal-addon-nombre" class="text-lg font-bold text-indigo-900 mt-1") —
          div(class="flex items-baseline gap-1 mt-1")
            p(id="modal-addon-precio" class="text-2xl font-extrabold text-indigo-700") —
            span(class="text-xs text-gray-400") /mes (ARS)

        p(class="text-sm font-semibold text-gray-700 mb-3") Método de pago

        div(class="grid grid-cols-2 gap-2 mb-5")
          div(class="flex items-center gap-2 border-2 border-blue-600 bg-blue-50 rounded-xl px-3 py-3 cursor-default")
            div(class="w-4 h-4 rounded-full border-2 border-blue-600 flex items-center justify-center shrink-0")
              div(class="w-2 h-2 rounded-full bg-blue-600")
            div
              p(class="text-xs font-bold text-blue-900 leading-tight") Tarjeta
              p(class="text-xs text-blue-500 leading-tight") crédito / débito

          div(class="flex items-center gap-2 border border-gray-200 bg-gray-50 rounded-xl px-3 py-3 opacity-50 cursor-not-allowed")
            div(class="w-4 h-4 rounded-full border-2 border-gray-300 shrink-0")
            div
              p(class="text-xs font-bold text-gray-400 leading-tight") MercadoPago
              p(class="text-xs text-gray-300 leading-tight") Próximamente

          div(class="flex items-center gap-2 border border-gray-200 bg-gray-50 rounded-xl px-3 py-3 opacity-50 cursor-not-allowed")
            div(class="w-4 h-4 rounded-full border-2 border-gray-300 shrink-0")
            div
              p(class="text-xs font-bold text-gray-400 leading-tight") Modo
              p(class="text-xs text-gray-300 leading-tight") Próximamente

          div(class="flex items-center gap-2 border border-gray-200 bg-gray-50 rounded-xl px-3 py-3 opacity-50 cursor-not-allowed")
            div(class="w-4 h-4 rounded-full border-2 border-gray-300 shrink-0")
            div
              p(class="text-xs font-bold text-gray-400 leading-tight") Transferencia
              p(class="text-xs text-gray-300 leading-tight") Próximamente

        form(id="form-addon" action="/mis-addons/agregar" method="POST" class="space-y-4")
          input(type="hidden" id="modal-addon-id" name="addonId")

          div
            label(class="block text-sm font-semibold text-gray-700 mb-1") Nombre en la tarjeta
            input(type="text" placeholder="NOMBRE APELLIDO" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")

          div
            label(class="block text-sm font-semibold text-gray-700 mb-1") Número de tarjeta
            input(type="text" placeholder="•••• •••• •••• ••••" maxlength="19" required oninput="formatearTarjeta(this)" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")

          div(class="grid grid-cols-2 gap-3")
            div
              label(class="block text-sm font-semibold text-gray-700 mb-1") Vencimiento
              input(type="text" placeholder="MM/AA" maxlength="5" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")
            div
              label(class="block text-sm font-semibold text-gray-700 mb-1") CVV
              input(type="text" placeholder="•••" maxlength="3" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")

          div(class="flex gap-3 pt-2")
            button(type="button" onclick="cerrarModal()" class="flex-1 border border-gray-300 text-gray-600 font-semibold py-2.5 rounded-xl text-sm hover:bg-gray-50 transition-colors") Cancelar
            button(type="submit" class="flex-1 bg-blue-900 hover:bg-blue-800 text-white font-bold py-2.5 rounded-xl text-sm transition-colors") Confirmar pago

    script.
      function abrirPagoAddon(btn) {
        document.getElementById('modal-addon-id').value = btn.dataset.addonId;
        document.getElementById('modal-addon-nombre').textContent = btn.dataset.addonNombre;
        document.getElementById('modal-addon-precio').textContent =
          '$' + Number(btn.dataset.addonPrecio).toLocaleString('es-AR');
        document.getElementById('modal-addon').classList.remove('hidden');
      }

      function cerrarModal() {
        document.getElementById('modal-addon').classList.add('hidden');
      }

      function formatearTarjeta(input) {
        var val = input.value.replace(/\D/g, '').substring(0, 16);
        input.value = val.replace(/(.{4})/g, '$1 ').trim();
      }

      document.getElementById('modal-addon').addEventListener('click', function(e) {
        if (e.target === this) cerrarModal();
      });
