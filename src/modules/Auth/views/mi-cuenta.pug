doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title TechRetail Solutions — Mi cuenta
    script(src="https://cdn.tailwindcss.com")
  body(class="bg-gradient-to-br from-blue-900 to-blue-700 min-h-screen flex items-center justify-center font-sans py-10 px-4")

    div(class="w-full max-w-md")

      div(class="text-center mb-6")
        h1(class="text-2xl font-bold text-white") TechRetail Solutions
        p(class="text-blue-200 text-sm") Panel del cliente

      div(class="bg-white rounded-2xl shadow-2xl p-8")

        // Avatar + nombre
        div(class="text-center mb-6")
          div(class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-3")
            span(class="text-3xl font-bold text-blue-900") #{usuario.nombre.charAt(0).toUpperCase()}
          h2(class="text-xl font-bold text-blue-900") #{usuario.nombre}
          p(class="text-gray-500 text-sm") #{usuario.email}

        // Info del plan
        div(class="bg-gray-50 rounded-xl p-5 mb-6")
          p(class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3") Mi plan actual

          if planActual
            if enTrial
              div(class="flex items-center gap-2 mb-2")
                span(class="bg-green-100 text-green-800 text-xs px-3 py-1 rounded-full font-bold") Período de prueba
                span(class="text-green-600 font-semibold text-sm") #{diasTrial} días restantes
              p(class="text-2xl font-extrabold text-blue-900") #{planActual.nombre}
              p(class="text-sm text-gray-500 mt-1")
                | Al vencer el trial: $#{planActual.precio.toLocaleString('es-AR')}/mes
              p(class="text-xs text-green-700 mt-2") Sin tarjeta requerida durante el período de prueba
            else
              p(class="text-2xl font-extrabold text-blue-900") #{planActual.nombre}
              p(class="text-3xl font-bold text-blue-700 mt-1")
                | $#{planActual.precio.toLocaleString('es-AR')}
                span(class="text-sm font-normal text-gray-400") /mes (ARS)
              div(class="mt-2")
                span(class="bg-blue-100 text-blue-800 text-xs px-3 py-1 rounded-full font-semibold") Plan activo
          else
            div(class="text-center py-4")
              p(class="text-gray-400 text-sm") No tenés un plan activo
              a(href="/elegir-plan" class="text-blue-700 font-semibold text-sm hover:underline") Elegir plan ahora

        // Add-ons contratados
        if addonsContratados && addonsContratados.length > 0
          div(class="mb-6")
            p(class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3") Add-ons activos
            div(class="space-y-2")
              each addon in addonsContratados
                div(class="flex items-center justify-between bg-indigo-50 rounded-lg px-4 py-3")
                  div
                    p(class="text-sm font-semibold text-indigo-900") #{addon.nombre}
                    p(class="text-xs text-indigo-500") $#{addon.precio.toLocaleString('es-AR')}/mes
                  form(action="/mis-addons/quitar" method="POST")
                    input(type="hidden" name="addonId" value=String(addon._id))
                    button(type="submit" class="text-xs text-red-400 hover:text-red-600 font-medium transition-colors") Cancelar

        // Add-ons disponibles
        if addonsDisponibles && addonsDisponibles.length > 0
          div(class="mb-6")
            p(class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3") Add-ons disponibles
            div(class="space-y-2")
              each addon in addonsDisponibles
                div(class="flex items-center justify-between bg-gray-50 rounded-lg px-4 py-3")
                  div
                    p(class="text-sm font-semibold text-gray-800") #{addon.nombre}
                    p(class="text-xs text-gray-400") #{addon.descripcion}
                    p(class="text-xs text-blue-700 font-medium mt-1") $#{addon.precio.toLocaleString('es-AR')}/mes
                  form(action="/mis-addons/agregar" method="POST")
                    input(type="hidden" name="addonId" value=String(addon._id))
                    button(type="submit" class="text-xs bg-blue-900 hover:bg-blue-800 text-white px-3 py-1 rounded-lg font-medium transition-colors") Contratar

        // Acciones
        div(class="space-y-3")
          a(href="/elegir-plan"
            class="block w-full text-center bg-blue-900 hover:bg-blue-800 text-white font-bold py-3 rounded-xl text-sm transition-colors")
            | Cambiar plan

          form(action="/logout" method="POST")
            button(type="submit"
              class="w-full text-gray-400 hover:text-red-500 text-sm py-2 transition-colors")
              | Cerrar sesión

      p(class="text-center text-blue-200 text-xs mt-6") © 2025 TechRetail Solutions S.R.L.
