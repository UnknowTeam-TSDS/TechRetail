doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title TechRetail Solutions — Cambiar contraseña
    script(src="https://cdn.tailwindcss.com")
    link(rel="manifest" href="/manifest.json")
    meta(name="theme-color" content="#1D4ED8")
    link(rel="apple-touch-icon" href="/icons/icon-192.png")
    script(src="/js/pwa.js")
  body(class="bg-gradient-to-br from-blue-900 to-blue-700 min-h-screen flex items-center justify-center font-sans px-4")

    div(class="w-full max-w-md")

      div(class="bg-white rounded-2xl shadow-2xl p-8")

        div(class="text-center mb-6")
          div(class="w-14 h-14 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-3")
            span(class="text-2xl") 🔐
          h1(class="text-xl font-bold text-blue-900") Cambiá tu contraseña
          p(class="text-gray-500 text-sm mt-1") Tu cuenta fue creada por un administrador. Por seguridad, elegí una contraseña personal antes de continuar.

        if error
          div(class="bg-red-100 border border-red-300 text-red-800 px-4 py-3 rounded-lg mb-5 text-sm") #{error}

        form(action="/cambiar-contrasena" method="POST" class="space-y-4")

          div
            label(class="block text-sm font-semibold text-gray-700 mb-1") Nueva contraseña
            input(type="password" name="contrasena" required data-password-policy placeholder="••••••••"
              title="Debe tener al menos 8 caracteres, con mayúscula, minúscula, número y símbolo."
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")
            ul(class="mt-2 space-y-1 text-xs")
              li#regla-longitud(class="text-gray-400 flex items-center gap-1.5")
                span(data-icono) ○
                span Mínimo 8 caracteres
              li#regla-mayuscula(class="text-gray-400 flex items-center gap-1.5")
                span(data-icono) ○
                span Una letra mayúscula
              li#regla-minuscula(class="text-gray-400 flex items-center gap-1.5")
                span(data-icono) ○
                span Una letra minúscula
              li#regla-numero(class="text-gray-400 flex items-center gap-1.5")
                span(data-icono) ○
                span Un número
              li#regla-simbolo(class="text-gray-400 flex items-center gap-1.5")
                span(data-icono) ○
                span Un símbolo (! @ # $ %)

          div
            label(class="block text-sm font-semibold text-gray-700 mb-1") Confirmar contraseña
            input(type="password" name="confirmar" required data-password-confirm placeholder="••••••••"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")

          button(type="submit"
            class="w-full bg-blue-900 hover:bg-blue-800 text-white font-bold py-3 rounded-xl text-sm transition-colors mt-2")
            | Guardar y continuar

      p(class="text-center text-blue-200 text-xs mt-6") © 2025 TechRetail Solutions S.R.L.

    script(src="/js/validacion.js")
    script(src="/js/password.js")
