doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title TechRetail Solutions — Crear cuenta
    script(src="https://cdn.tailwindcss.com")
  body(class="bg-gradient-to-br from-blue-900 to-blue-700 min-h-screen py-10 font-sans")
    div(class="max-w-5xl mx-auto px-4")

      // Header
      div(class="text-center mb-8")
        h1(class="text-3xl font-bold text-white") TechRetail Solutions
        p(class="text-blue-200 text-sm mt-1") Empezá gratis o elegí el plan que mejor se adapta a tu negocio

      // Error
      if error
        div(class="bg-red-100 border border-red-300 text-red-800 px-4 py-3 rounded-lg mb-6 text-sm text-center") #{error}

      // Card principal
      div(class="bg-white rounded-2xl shadow-2xl overflow-hidden")
        form(action="/registro" method="POST")
          div(class="grid md:grid-cols-2")

            // ── Izquierda: selección de plan ──────────────────────
            div(class="bg-gray-50 p-8 border-b md:border-b-0 md:border-r border-gray-200")
              h2(class="text-xl font-bold text-blue-900 mb-1") Elegí tu plan
              p(class="text-sm text-gray-500 mb-6") Podés cambiarlo en cualquier momento

              // Prueba gratuita
              label(class="plan-card block border-2 rounded-xl p-4 mb-3 cursor-pointer transition-all border-green-400 bg-green-50")
                div(class="flex items-start gap-3")
                  input(type="radio" name="planSeleccionado" value="trial" checked class="mt-1 accent-green-600")
                  div(class="flex-1")
                    div(class="flex items-center gap-2 flex-wrap")
                      span(class="font-bold text-green-900") Prueba gratuita
                      span(class="text-xs bg-green-600 text-white px-2 py-0.5 rounded-full font-semibold") 14 días
                    p(class="text-xs text-green-700 mt-1") Acceso completo sin tarjeta de crédito
                    p(class="text-2xl font-bold text-green-800 mt-2") GRATIS

              // Planes pagos
              each plan in planes
                label(class="plan-card block border-2 rounded-xl p-4 mb-3 cursor-pointer transition-all border-gray-200 hover:border-blue-300 bg-white")
                  div(class="flex items-start gap-3")
                    input(type="radio" name="planSeleccionado" value=String(plan._id) class="mt-1 accent-blue-700")
                    div(class="flex-1")
                      p(class="font-bold text-blue-900") #{plan.nombre}
                      p(class="text-xs text-gray-500 mt-1") #{plan.descripcion}
                      div(class="flex items-baseline gap-1 mt-2")
                        span(class="text-2xl font-bold text-blue-900") $#{plan.precio.toLocaleString('es-AR')}
                        span(class="text-xs text-gray-400") /mes (ARS)

            // ── Derecha: datos del usuario ────────────────────────
            div(class="p-8")
              h2(class="text-xl font-bold text-blue-900 mb-6") Tus datos

              div(class="space-y-4")
                div
                  label(class="block text-sm font-semibold text-gray-700 mb-1") Nombre completo *
                  input(type="text" name="nombre" required placeholder="Ej: Ana García"
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")

                div
                  label(class="block text-sm font-semibold text-gray-700 mb-1") Email *
                  input(type="email" name="email" required placeholder="tu@empresa.com"
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")

                div
                  label(class="block text-sm font-semibold text-gray-700 mb-1") Contraseña * (mín. 6 caracteres)
                  input(type="password" name="contrasena" required minlength="6" placeholder="••••••••"
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")

                div
                  label(class="block text-sm font-semibold text-gray-700 mb-1") Empresa
                  input(type="text" name="empresa" placeholder="Nombre de tu tienda o empresa"
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")

                div
                  label(class="block text-sm font-semibold text-gray-700 mb-1") Teléfono
                  input(type="tel" name="telefono" placeholder="+54 9 11 1234-5678"
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")

              button(type="submit"
                class="mt-6 w-full bg-blue-900 hover:bg-blue-800 text-white font-bold py-3 rounded-xl text-sm transition-colors shadow-md")
                | Crear mi cuenta

              p(class="mt-4 text-center text-xs text-gray-400")
                | ¿Ya tenés cuenta?&nbsp;
                a(href="/login" class="text-blue-700 font-semibold hover:underline") Iniciá sesión

      // Footer
      p(class="text-center text-blue-200 text-xs mt-8") © 2025 TechRetail Solutions S.R.L.

    script.
      const cards = document.querySelectorAll('.plan-card');
      const radios = document.querySelectorAll('input[name="planSeleccionado"]');

      function actualizarCards() {
        cards.forEach(card => {
          const radio = card.querySelector('input[type="radio"]');
          if (radio.checked) {
            card.style.borderColor = '#3b82f6';
            card.style.backgroundColor = '#eff6ff';
            card.style.boxShadow = '0 0 0 2px #93c5fd';
          } else {
            card.style.borderColor = '#e5e7eb';
            card.style.backgroundColor = '';
            card.style.boxShadow = '';
          }
        });
        // Trial card always gets green when selected
        const trialCard = document.querySelector('input[value="trial"]')?.closest('.plan-card');
        const trialRadio = document.querySelector('input[value="trial"]');
        if (trialRadio?.checked && trialCard) {
          trialCard.style.borderColor = '#16a34a';
          trialCard.style.backgroundColor = '#f0fdf4';
          trialCard.style.boxShadow = '0 0 0 2px #86efac';
        }
      }

      radios.forEach(r => r.addEventListener('change', actualizarCards));
      actualizarCards();
