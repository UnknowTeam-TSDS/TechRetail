extends ../../../views/layout

block contenido
  h2(class="text-2xl font-bold text-blue-900 mb-6") #{titulo}

  // Formulario agregar
  div(class="bg-white rounded-xl shadow-md p-6 mb-6")
    h3(class="text-lg font-semibold text-blue-900 mb-4") Registrar nuevo usuario
    form(action="/usuarios/form" method="POST")
      div(class="grid grid-cols-2 gap-4")
        div
          label(class="block text-sm text-gray-600 mb-1") Nombre
          input(type="text" name="nombre" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")
        div
          label(class="block text-sm text-gray-600 mb-1") Email
          input(type="email" name="email" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")
        div
          label(class="block text-sm text-gray-600 mb-1") Empresa
          input(type="text" name="empresa" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")
        div
          label(class="block text-sm text-gray-600 mb-1") Teléfono
          input(type="tel" name="telefono" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")
        div
          label(class="block text-sm text-gray-600 mb-1") Contraseña
          input(type="password" name="contrasena" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")
        div(class="col-span-2")
          p(class="text-xs text-gray-400 mt-1") El cliente elegirá su plan al iniciar sesión por primera vez.
        div
          button(type="submit" class="mt-2 bg-blue-900 text-white px-5 py-2 rounded-lg text-sm font-semibold hover:bg-blue-800 transition-colors") + Registrar Usuario

  // Tabla
  div(class="rounded-xl overflow-x-auto shadow-md")
    table(class="w-full min-w-[1000px] border-collapse bg-white")
      thead
        tr
          th(class="bg-blue-900 text-white text-left text-sm px-4 py-3") ID
          th(class="bg-blue-900 text-white text-left text-sm px-4 py-3") Nombre
          th(class="bg-blue-900 text-white text-left text-sm px-4 py-3") Email
          th(class="bg-blue-900 text-white text-left text-sm px-4 py-3") Empresa
          th(class="bg-blue-900 text-white text-left text-sm px-4 py-3") Teléfono
          th(class="bg-blue-900 text-white text-left text-sm px-4 py-3") Plan
          th(class="bg-blue-900 text-white text-left text-sm px-4 py-3") Estado
          th(class="bg-blue-900 text-white text-left text-sm px-4 py-3") Fecha Registro
          th(class="bg-blue-900 text-white text-left text-sm px-4 py-3") Acción
      tbody
        each usuario in usuarios
          tr(class="border-b border-gray-100 hover:bg-blue-50 transition-colors")
            td(class="px-4 py-3 text-xs text-gray-400 whitespace-nowrap") #{usuario._id}
            td(class="px-4 py-3 text-sm font-medium whitespace-nowrap") #{usuario.nombre}
            td(class="px-4 py-3 text-sm text-gray-500") #{usuario.email}
            td(class="px-4 py-3 text-sm") #{usuario.empresa || '—'}
            td(class="px-4 py-3 text-sm whitespace-nowrap") #{usuario.telefono || '—'}
            td(class="px-4 py-3")
              - const enTrialU = usuario.trialHasta && new Date(usuario.trialHasta) > new Date()
              div(class="flex flex-col gap-1 items-start")
                if usuario.planId
                  - const colores = { starter: 'bg-green-100 text-green-800', growth: 'bg-blue-100 text-blue-800', pro: 'bg-purple-100 text-purple-800' }
                  - const colorBase = colores[usuario.planId.nombre.toLowerCase()] || 'bg-gray-100 text-gray-800'
                  span(class='inline-block px-3 py-1 rounded-full text-xs font-semibold ' + colorBase) #{usuario.planId.nombre}
                else if !enTrialU
                  span(class="text-gray-400 text-xs") Sin plan
                if enTrialU
                  - const diasRestantes = Math.ceil((new Date(usuario.trialHasta) - new Date()) / (1000 * 60 * 60 * 24))
                  span(class="inline-block whitespace-nowrap px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-700") En prueba · #{diasRestantes}d
                else if usuario.trialHasta && !usuario.planId
                  span(class="inline-block whitespace-nowrap px-2 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-500") Prueba vencida
            td(class="px-4 py-3 text-sm whitespace-nowrap")
              if usuario.estado === 'activo'
                span(class="text-green-600 font-medium") Activo
              else if usuario.estado === 'suspendido'
                span(class="text-yellow-600 font-medium") Suspendido
              else
                span(class="text-red-500 font-medium") Inactivo
            td(class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap")= new Date(usuario.fechaRegistro).toLocaleDateString('es-AR')
            td(class="px-4 py-3")
              div(class="flex flex-col gap-1")
                form(action="/usuarios/estado/" + usuario._id method="POST" class="flex items-center gap-1")
                  select(name="estado" class="border border-gray-300 rounded text-xs px-1 py-1 focus:outline-none focus:ring-1 focus:ring-blue-400")
                    option(value="activo" selected=(usuario.estado === 'activo')) Activo
                    option(value="inactivo" selected=(usuario.estado === 'inactivo')) Inactivo
                    option(value="suspendido" selected=(usuario.estado === 'suspendido')) Suspendido
                  button(type="submit" class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs font-semibold hover:bg-blue-200 transition-colors") Cambiar
                form(action="/usuarios/eliminar/" + usuario._id method="POST" onsubmit="return confirm('¿Eliminar este usuario?')")
                  button(type="submit" class="bg-red-100 text-red-700 px-2 py-1 rounded text-xs font-semibold hover:bg-red-200 transition-colors w-full") Eliminar