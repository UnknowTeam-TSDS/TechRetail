doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title TechRetail Solutions — #{tienda ? 'Editar tienda' : 'Crear tienda'}
    script(src="https://cdn.tailwindcss.com")
    link(rel="manifest" href="/manifest.json")
    meta(name="theme-color" content="#1D4ED8")
    link(rel="apple-touch-icon" href="/icons/icon-192.png")
    script(src="/js/pwa.js")
  body(class="bg-gradient-to-br from-blue-900 to-blue-700 min-h-screen font-sans py-10 px-4")

    div(class="max-w-2xl mx-auto")

      div(class="text-center mb-6")
        h1(class="text-2xl font-bold text-white") TechRetail Solutions
        p(class="text-blue-200 text-sm") Configuración de tu tienda

      div(class="bg-white rounded-2xl shadow-2xl p-8 mb-4")
        h2(class="text-lg font-bold text-blue-900 mb-1")
          if tienda
            | Editar tienda
          else
            | Crear mi tienda
        p(class="text-sm text-gray-400 mb-6") Completá los datos que van a identificar tu tienda en la plataforma.

        if enTrial
          div(class="bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 mb-6")
            p(class="text-sm text-amber-800")
              | Durante el período de prueba tu tienda permanecerá en construcción.
              |  Activá un plan pago para publicarla.

        form(action="/mi-tienda" method="POST" class="space-y-5")

          div
            label(class="block text-sm font-semibold text-gray-700 mb-1") Nombre de la tienda *
            input(
              type="text"
              name="nombre"
              required
              minlength="3"
              value=tienda ? tienda.nombre : ''
              placeholder="Ej: Zapatillas Luna"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")

          div
            label(class="block text-sm font-semibold text-gray-700 mb-1") Descripción / slogan
            textarea(
              name="descripcion"
              rows="2"
              placeholder="Ej: Calzado artesanal para toda la familia"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400 resize-none")
              if tienda && tienda.descripcion
                | #{tienda.descripcion}

          div
            label(class="block text-sm font-semibold text-gray-700 mb-1") Rubro *
            select(
              name="rubro"
              required
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")
              option(value="" disabled selected=!tienda) Seleccioná un rubro
              option(value="moda" selected=tienda && tienda.rubro === 'moda') Moda y accesorios
              option(value="electronica" selected=tienda && tienda.rubro === 'electronica') Electrónica
              option(value="hogar" selected=tienda && tienda.rubro === 'hogar') Hogar y deco
              option(value="alimentos" selected=tienda && tienda.rubro === 'alimentos') Alimentos y bebidas
              option(value="servicios" selected=tienda && tienda.rubro === 'servicios') Servicios
              option(value="otro" selected=tienda && tienda.rubro === 'otro') Otro

          if !enTrial
            div
              label(class="block text-sm font-semibold text-gray-700 mb-1") Estado
              select(
                name="estado"
                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")
                option(value="en_construccion" selected=!tienda || tienda.estado === 'en_construccion') En construcción
                option(value="activa" selected=tienda && tienda.estado === 'activa') Activa
                option(value="inactiva" selected=tienda && tienda.estado === 'inactiva') Inactiva

          div(class="border-t border-gray-100 pt-5")
            p(class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-1") Información de contacto
            p(class="text-xs text-gray-400 mb-4") Obligatoria por ley (Res. 104/2005 — Defensa del Consumidor).

            div(class="space-y-4")
              div
                label(class="block text-sm font-semibold text-gray-700 mb-1") Email de contacto *
                input(
                  type="email"
                  name="emailContacto"
                  required
                  value=tienda && tienda.emailContacto ? tienda.emailContacto : ''
                  placeholder="Ej: contacto@minegoicio.com"
                  class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")

              div
                label(class="block text-sm font-semibold text-gray-700 mb-1") Teléfono *
                input(
                  type="tel"
                  name="telefono"
                  required
                  value=tienda && tienda.telefono ? tienda.telefono : ''
                  placeholder="Ej: +54 9 11 1234-5678"
                  class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")

              div
                label(class="block text-sm font-semibold text-gray-700 mb-1") Dirección *
                input(
                  type="text"
                  name="direccion"
                  required
                  value=tienda && tienda.direccion ? tienda.direccion : ''
                  placeholder="Ej: Av. Corrientes 1234, CABA"
                  class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")

              div
                label(class="block text-sm font-semibold text-gray-700 mb-1") WhatsApp
                  span(class="text-gray-400 font-normal text-xs ml-1") (opcional)
                input(
                  type="tel"
                  name="whatsapp"
                  value=tienda && tienda.whatsapp ? tienda.whatsapp : ''
                  placeholder="Ej: +54 9 11 1234-5678"
                  class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")
                p(class="text-xs text-gray-400 mt-1") Si lo cargás, tus clientes verán un botón para contactarte por WhatsApp.

          div(class="flex gap-3 pt-2")
            a(href="/mi-tienda" class="flex-1 text-center bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-3 rounded-xl text-sm transition-colors") Cancelar
            button(
              type="submit"
              class="flex-1 bg-blue-900 hover:bg-blue-800 text-white font-bold py-3 rounded-xl text-sm transition-colors")
              if tienda
                | Guardar cambios
              else
                | Crear tienda

    p(class="text-center text-blue-200 text-xs mt-6 mb-4") © 2025 TechRetail Solutions S.R.L.

    script(src="/js/validacion.js")
