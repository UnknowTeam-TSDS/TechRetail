doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title #{tienda.nombre}
    if tienda.tituloSEO
      meta(name="title" content=tienda.tituloSEO)
    script(src="https://cdn.tailwindcss.com")
    link(rel="manifest" href="/manifest.json")
    meta(name="theme-color" content="#1D4ED8")
    link(rel="apple-touch-icon" href="/icons/icon-192.png")
    script(src="/js/pwa.js")
    style.
      :root { --color-marca: #{tienda.colorPrimario}; }
      .bg-marca { background-color: var(--color-marca); }
      .text-marca { color: var(--color-marca); }
      .border-marca { border-color: var(--color-marca); }
      .btn-marca { background-color: var(--color-marca); }
      .btn-marca:hover { filter: brightness(.94); }
      .btn-cat.activo { background-color: var(--color-marca); color: #fff; border-color: var(--color-marca); }
      .btn-cat:not(.activo):hover { border-color: var(--color-marca); color: var(--color-marca); }
      .store-bg {
        background:
          radial-gradient(circle at top left, rgba(29, 78, 216, .12), transparent 30rem),
          linear-gradient(180deg, #f8fafc 0%, #eef3f8 100%);
      }
      .surface { background: rgba(255, 255, 255, .9); box-shadow: 0 18px 45px rgba(15, 23, 42, .07); }
      .product-card { box-shadow: 0 14px 35px rgba(15, 23, 42, .06); }
      .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  body(class="store-bg min-h-screen font-sans text-slate-900")
    - const ocultarContacto = tienda.estado === 'en_construccion' && !previsualizando
    - const cantidad = carritoCantidad || 0

    header(class="bg-white/90 backdrop-blur border-b border-slate-200")
      div(class="max-w-6xl mx-auto px-5 py-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4")
        a(href="/tienda/" + tienda._id class="flex items-center gap-3 group")
          div(class="w-11 h-11 rounded-xl bg-marca flex items-center justify-center text-white font-extrabold text-lg shrink-0")
            | #{tienda.nombre.charAt(0).toUpperCase()}
          div
            h1(class="text-lg font-extrabold text-slate-950 leading-tight group-hover:text-marca transition-colors") #{tienda.nombre}
            if tienda.descripcion
              p(class="text-sm text-slate-500 line-clamp-2") #{tienda.descripcion}

        div(class="flex flex-wrap items-center gap-2 text-sm")
          if !ocultarContacto
            span(class="inline-flex items-center bg-slate-100 text-slate-600 px-3 py-1.5 rounded-full capitalize text-xs font-bold") #{tienda.rubro}
            if tienda.emailContacto
              a(href="mailto:" + tienda.emailContacto class="hidden sm:inline-flex text-slate-500 hover:text-slate-900 transition-colors") #{tienda.emailContacto}
          if tienda.estado === 'activa' || previsualizando
            a(href="/tienda/" + tienda._id + "/carrito" class="inline-flex items-center gap-2 bg-slate-950 text-white px-4 py-2.5 rounded-xl text-xs font-bold hover:bg-slate-800 transition-colors")
              span Carrito
              span(class="bg-white text-slate-950 rounded-full min-w-5 h-5 px-1.5 flex items-center justify-center") #{cantidad}

    main(class="max-w-6xl mx-auto px-5 py-8")
      if previsualizando
        div(class="bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 mb-6 flex flex-col sm:flex-row sm:items-center gap-3")
          div(class="flex-1")
            p(class="text-sm font-bold text-amber-800") Vista previa
            p(class="text-xs text-amber-700 mt-0.5") Asi se vera tu tienda cuando la publiques. Todavia no esta visible para el publico.
          a(href="/mi-tienda" class="shrink-0 bg-amber-100 hover:bg-amber-200 text-amber-800 text-xs font-bold px-3 py-1.5 rounded-lg transition-colors text-center") Configurar

      if tienda.estado === 'en_construccion' && !previsualizando
        section(class="min-h-[55vh] surface rounded-3xl border border-white flex flex-col items-center justify-center text-center px-6 py-20")
          div(class="w-20 h-20 rounded-2xl bg-marca flex items-center justify-center text-white font-extrabold text-4xl mb-6 mx-auto")
            | #{tienda.nombre.charAt(0).toUpperCase()}
          h2(class="text-3xl font-extrabold text-slate-950 mb-3") Proximamente
          p(class="text-slate-500 text-lg max-w-md") Estamos armando la tienda. Volve pronto para ver todos los productos.
      else
        section(class="surface rounded-3xl border border-white overflow-hidden mb-8")
          div(class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-0")
            div(class="p-7 md:p-9")
              p(class="text-xs font-extrabold uppercase tracking-[0.18em] text-marca mb-3") Tienda online
              h2(class="text-3xl md:text-4xl font-extrabold text-slate-950 leading-tight") #{tienda.nombre}
              if tienda.descripcion
                p(class="text-slate-600 mt-3 max-w-2xl leading-relaxed") #{tienda.descripcion}
              div(class="flex flex-wrap gap-2 mt-6")
                span(class="inline-flex items-center bg-slate-100 text-slate-700 px-3 py-1.5 rounded-full text-xs font-bold capitalize") #{tienda.rubro}
                if productos.length > 0
                  span(class="inline-flex items-center bg-white border border-slate-200 text-slate-600 px-3 py-1.5 rounded-full text-xs font-bold") #{productos.length} productos
                if previsualizando
                  span(class="inline-flex items-center bg-amber-50 text-amber-700 px-3 py-1.5 rounded-full text-xs font-bold") En vista previa
            div(class="bg-slate-950 text-white p-7 flex flex-col justify-center")
              if previsualizando
                p(class="text-xs font-bold text-slate-400 uppercase tracking-wide") Vista previa
                p(class="text-2xl font-extrabold mt-2") Catalogo, carrito y checkout preparado.
                p(class="text-sm text-slate-300 mt-3 leading-relaxed") Revisa como se vera la experiencia de compra antes de publicar.
              else
                p(class="text-xs font-bold text-slate-400 uppercase tracking-wide") Compra online
                p(class="text-2xl font-extrabold mt-2") Explora el catalogo y arma tu pedido.
                p(class="text-sm text-slate-300 mt-3 leading-relaxed") Agrega productos al carrito y continua con el metodo de pago que prefieras.

        if productos.length > 0
          div(class="mb-5")
            input(type="search" oninput="buscar(this.value)" placeholder="Buscar productos por nombre..." class="w-full sm:max-w-sm border border-slate-300 rounded-xl px-4 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-300")

        if categorias.length > 0
          div(class="flex flex-wrap gap-2 mb-7")
            button(type="button" data-filtro="todos" onclick="filtrar(this)" class="btn-cat activo border border-slate-300 rounded-full px-4 py-2 text-sm font-bold transition-colors cursor-pointer") Todos
            each cat in categorias
              button(type="button" data-filtro=cat onclick="filtrar(this)" class="btn-cat border border-slate-300 bg-white rounded-full px-4 py-2 text-sm font-bold transition-colors cursor-pointer") #{cat}

        //- Mensaje cuando la búsqueda/filtro no deja resultados visibles (lo controla el JS).
        div#sin-resultados(class="hidden surface rounded-3xl border border-white text-center px-6 py-12 mb-5")
          p(class="text-slate-500 text-sm") No encontramos productos con ese criterio.

        if productos.length === 0
          div(class="surface rounded-3xl border border-white min-h-[36vh] flex flex-col items-center justify-center text-center px-6 py-16")
            div(class="w-14 h-14 rounded-2xl bg-slate-100 flex items-center justify-center text-slate-400 font-extrabold text-xl mb-4") 0
            p(class="text-xl font-extrabold text-slate-900") Todavia no hay productos publicados.
            p(class="text-slate-500 text-sm mt-2 max-w-sm") Cuando el catalogo tenga productos activos, tus clientes los veran aca.
        else
          div#grilla(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5")
            each producto in productos
              - const cat = producto.categoria || ''
              - const sinStock = producto.tipo === 'fisico' && producto.stock <= 0
              article(class="producto-card bg-white rounded-2xl border border-white overflow-hidden hover:-translate-y-0.5 hover:shadow-xl transition-all flex flex-col" data-categoria=cat data-nombre=(producto.nombre || '').toLowerCase())
                a(href="/tienda/" + tienda._id + "/producto/" + producto._id class="block flex-1")
                  div(class="relative bg-gradient-to-br from-slate-100 to-blue-50 aspect-[4/3] overflow-hidden")
                    if producto.imagenes && producto.imagenes.length > 0
                      img(src=producto.imagenes[0] alt=producto.nombre class="w-full h-full object-cover" onerror="this.parentElement.innerHTML='<div class=\\'w-full h-full flex items-center justify-center text-slate-400 text-sm font-bold\\'>Sin imagen</div>'")
                    else
                      div(class="w-full h-full flex items-center justify-center text-slate-400 text-sm font-bold") Sin imagen

                    div(class="absolute top-3 left-3 flex flex-col gap-1")
                      if producto.esOferta
                        span(class="bg-red-500 text-white text-xs font-bold px-2.5 py-1 rounded-full") Oferta
                      if producto.esNovedad
                        span(class="bg-blue-500 text-white text-xs font-bold px-2.5 py-1 rounded-full") Nuevo
                      if producto.destacado
                        span(class="bg-amber-400 text-white text-xs font-bold px-2.5 py-1 rounded-full") Destacado

                  div(class="p-4 pb-2")
                    if cat
                      p(class="text-[11px] text-slate-400 font-bold uppercase tracking-wide mb-1") #{cat}
                    h3(class="text-sm font-extrabold text-slate-950 leading-snug mb-2 line-clamp-2") #{producto.nombre}
                    if producto.descripcion
                      p(class="text-xs text-slate-500 mb-3 line-clamp-2") #{producto.descripcion}
                    if producto.precioPromocional !== null && producto.precioPromocional !== undefined
                      div(class="flex items-baseline gap-2")
                        span(class="text-marca text-lg font-extrabold") $#{producto.precioPromocional.toLocaleString('es-AR')}
                        span(class="text-xs text-slate-400 line-through") $#{producto.precio.toLocaleString('es-AR')}
                    else
                      span(class="text-marca text-lg font-extrabold") $#{producto.precio.toLocaleString('es-AR')}

                if tienda.estado === 'activa' || previsualizando
                  form(action="/tienda/" + tienda._id + "/carrito/agregar/" + producto._id method="POST" class="p-4 pt-2")
                    input(type="hidden" name="cantidad" value="1")
                    if sinStock
                      button(type="button" disabled class="w-full bg-slate-100 text-slate-400 font-bold py-2.5 rounded-xl text-xs cursor-not-allowed") Sin stock
                    else
                      button(type="submit" class="btn-marca w-full text-white font-bold py-2.5 rounded-xl text-xs transition-all") Agregar al carrito

    footer(class="border-t border-slate-200 mt-16 py-8 text-center text-xs text-slate-400")
      p
        if ocultarContacto
          | #{tienda.nombre}
        else
          | #{tienda.nombre} - #{tienda.direccion}
      p(class="mt-1")
        | Plataforma
        span(class="text-slate-500 ml-1") TechRetail Solutions

    script.
      // Estado de los filtros del catálogo: categoría activa + texto de búsqueda.
      var categoriaActiva = 'todos';
      var textoBusqueda = '';

      // Una sola función aplica ambos filtros a la vez (categoría Y texto).
      function aplicarFiltros() {
        var visibles = 0;
        document.querySelectorAll('.producto-card').forEach(function(card) {
          var cat = card.getAttribute('data-categoria');
          var nombre = card.getAttribute('data-nombre') || '';
          var coincideCategoria = categoriaActiva === 'todos' || cat === categoriaActiva;
          var coincideTexto = textoBusqueda === '' || nombre.indexOf(textoBusqueda) !== -1;
          var visible = coincideCategoria && coincideTexto;
          card.style.display = visible ? '' : 'none';
          if (visible) visibles++;
        });
        var aviso = document.getElementById('sin-resultados');
        if (aviso) aviso.classList.toggle('hidden', visibles > 0);
      }

      function filtrar(btn) {
        categoriaActiva = btn.getAttribute('data-filtro');
        document.querySelectorAll('.btn-cat').forEach(function(b) {
          b.classList.toggle('activo', b === btn);
        });
        aplicarFiltros();
      }

      function buscar(valor) {
        textoBusqueda = valor.trim().toLowerCase();
        aplicarFiltros();
      }
