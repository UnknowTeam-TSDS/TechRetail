doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title TechRetail Solutions — Mi Tienda
    script(src="https://cdn.tailwindcss.com")
  body(class="bg-gradient-to-br from-blue-900 to-blue-700 min-h-screen font-sans py-10 px-4")

    div(class="max-w-2xl mx-auto")

      div(class="text-center mb-6")
        h1(class="text-2xl font-bold text-white") TechRetail Solutions
        p(class="text-blue-200 text-sm") Tu tienda

      if !tienda
        //- ── SIN TIENDA ──────────────────────────────────────────────────────
        div(class="bg-white rounded-2xl shadow-2xl p-10 text-center mb-4")
          div(class="text-5xl mb-4") 🏪
          h2(class="text-lg font-bold text-blue-900 mb-2") Todavía no creaste tu tienda
          p(class="text-sm text-gray-500 max-w-sm mx-auto mb-6") Configurá el nombre, el rubro y los datos de contacto para empezar a cargar productos.
          a(href="/mi-tienda/editar" class="inline-block bg-blue-900 hover:bg-blue-800 text-white font-bold px-6 py-3 rounded-xl text-sm transition-colors") Crear mi tienda

      else
        //- ── RESUMEN DE LA TIENDA ────────────────────────────────────────────
        div(class="bg-white rounded-2xl shadow-2xl overflow-hidden mb-4")
          div(class="h-2" style=`background-color:${tienda.colorPrimario}`)
          div(class="p-8")
            div(class="flex items-start justify-between gap-3 mb-5")
              div
                h2(class="text-xl font-bold text-gray-900") #{tienda.nombre}
                if tienda.descripcion
                  p(class="text-sm text-gray-500 mt-1") #{tienda.descripcion}
              div(class="shrink-0")
                if tienda.estado === 'activa'
                  span(class="bg-green-100 text-green-800 text-xs font-bold px-3 py-1.5 rounded-full") Publicada
                else if tienda.estado === 'inactiva'
                  span(class="bg-red-100 text-red-600 text-xs font-bold px-3 py-1.5 rounded-full") Inactiva
                else
                  span(class="bg-amber-100 text-amber-700 text-xs font-bold px-3 py-1.5 rounded-full") En construcción

            div(class="flex items-center gap-2 mb-5")
              div(class="w-4 h-4 rounded-full border border-gray-200" style=`background-color:${tienda.colorPrimario}`)
              span(class="text-xs text-gray-500 capitalize") #{tienda.rubro}

            div(class="border-t border-gray-100 pt-5")
              p(class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-3") Información de contacto
              dl(class="space-y-2 text-sm")
                div(class="flex justify-between gap-4")
                  dt(class="text-gray-400 shrink-0") Email
                  dd(class="text-gray-700 text-right break-all") #{tienda.emailContacto}
                div(class="flex justify-between gap-4")
                  dt(class="text-gray-400 shrink-0") Teléfono
                  dd(class="text-gray-700 text-right") #{tienda.telefono}
                div(class="flex justify-between gap-4")
                  dt(class="text-gray-400 shrink-0") Dirección
                  dd(class="text-gray-700 text-right") #{tienda.direccion}
                if tienda.whatsapp
                  div(class="flex justify-between gap-4")
                    dt(class="text-gray-400 shrink-0") WhatsApp
                    dd(class="text-gray-700 text-right") #{tienda.whatsapp}

        if enTrial
          div(class="bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 mb-4")
            p(class="text-sm text-amber-800")
              | Durante el período de prueba tu tienda permanece en construcción.
              |  Activá un plan pago para publicarla.

        //- ── ACCIONES ────────────────────────────────────────────────────────
        div(class="space-y-3 mb-4")
          a(href="/mi-tienda/editar"
            class="block w-full text-center bg-blue-900 hover:bg-blue-800 text-white font-bold py-3 rounded-xl text-sm transition-colors")
            | Editar tienda

          a(href="/mis-productos"
            class="block w-full text-center bg-teal-600 hover:bg-teal-700 text-white font-bold py-3 rounded-xl text-sm transition-colors")
            | Gestionar productos →

          a(href="/tienda/" + tienda._id target="_blank"
            class="block w-full text-center bg-white border border-blue-200 text-blue-900 font-bold py-3 rounded-xl text-sm transition-colors hover:bg-blue-50")
            if tienda.estado === 'activa'
              | Ver mi tienda publicada →
            else
              | Ver vista previa de mi tienda →

      div(class="text-center")
        a(href="/mi-cuenta" class="text-blue-200 text-sm hover:text-white") ← Volver a mi cuenta

    p(class="text-center text-blue-200 text-xs mt-6 mb-4") © 2025 TechRetail Solutions S.R.L.
