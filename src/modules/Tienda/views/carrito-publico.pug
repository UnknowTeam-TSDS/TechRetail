doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Carrito - #{tienda.nombre}
    script(src="https://cdn.tailwindcss.com")
    style.
      :root { --color-marca: #{tienda.colorPrimario}; }
      .bg-marca { background-color: var(--color-marca); }
      .text-marca { color: var(--color-marca); }
      .btn-marca { background-color: var(--color-marca); }
      .btn-marca:hover { filter: brightness(.94); }
      .store-bg {
        background:
          radial-gradient(circle at top left, rgba(29, 78, 216, .12), transparent 30rem),
          linear-gradient(180deg, #f8fafc 0%, #eef3f8 100%);
      }
      .surface { background: rgba(255, 255, 255, .92); box-shadow: 0 18px 45px rgba(15, 23, 42, .07); }

  body(class="store-bg min-h-screen font-sans text-slate-900")
    header(class="bg-white/90 backdrop-blur border-b border-slate-200")
      div(class="max-w-6xl mx-auto px-5 py-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4")
        a(href="/tienda/" + tienda._id class="flex items-center gap-3 group")
          div(class="w-11 h-11 rounded-xl bg-marca flex items-center justify-center text-white font-extrabold text-lg shrink-0")
            | #{tienda.nombre.charAt(0).toUpperCase()}
          div
            p(class="font-extrabold text-slate-950 group-hover:text-marca transition-colors") #{tienda.nombre}
            p(class="text-xs text-slate-500") Carrito de compras
        a(href="/tienda/" + tienda._id class="text-sm text-slate-500 hover:text-slate-900 transition-colors") Seguir comprando

    main(class="max-w-6xl mx-auto px-5 py-8")
      if previsualizando
        div(class="bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 mb-6")
          p(class="text-sm font-bold text-amber-800") Vista previa del checkout
          p(class="text-xs text-amber-700 mt-1") Estas simulando el carrito como lo veria un cliente. El publico solo podra usarlo cuando la tienda este publicada.

      div(class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-6")
        section(class="surface border border-white rounded-3xl overflow-hidden")
          div(class="px-6 py-5 border-b border-slate-100 flex items-center justify-between gap-4")
            div
              h1(class="text-2xl font-extrabold text-slate-950") Tu carrito
              p(class="text-sm text-slate-500 mt-1") Revisa productos y cantidades antes de continuar.
            if cantidadTotal > 0
              form(action="/tienda/" + tienda._id + "/carrito/vaciar" method="POST")
                button(type="submit" class="text-xs font-bold text-red-500 hover:text-red-700") Vaciar

          if items.length === 0
            div(class="px-6 py-20 text-center")
              div(class="w-16 h-16 rounded-2xl bg-slate-100 mx-auto mb-4 flex items-center justify-center text-slate-400 font-extrabold") 0
              p(class="text-xl font-extrabold text-slate-900") Tu carrito esta vacio
              p(class="text-sm text-slate-500 mt-1") Agrega productos desde el catalogo de la tienda.
              a(href="/tienda/" + tienda._id class="inline-flex mt-6 btn-marca text-white font-bold px-5 py-3 rounded-xl text-sm transition-all") Ver productos
          else
            div(class="divide-y divide-slate-100")
              each item in items
                - const producto = item.producto
                div(class="p-5 flex flex-col sm:flex-row gap-4")
                  a(href="/tienda/" + tienda._id + "/producto/" + producto._id class="w-full sm:w-28 h-28 bg-gradient-to-br from-slate-100 to-blue-50 rounded-2xl overflow-hidden shrink-0 flex items-center justify-center")
                    if producto.imagenes && producto.imagenes.length > 0
                      img(src=producto.imagenes[0] alt=producto.nombre class="w-full h-full object-cover" onerror="this.parentElement.innerHTML='<span class=\\'text-xs text-slate-400 font-bold\\'>Sin imagen</span>'")
                    else
                      span(class="text-xs text-slate-400 font-bold") Sin imagen

                  div(class="flex-1 min-w-0")
                    if producto.categoria
                      p(class="text-xs text-slate-400 uppercase font-bold tracking-wide") #{producto.categoria}
                    a(href="/tienda/" + tienda._id + "/producto/" + producto._id class="font-extrabold text-slate-950 hover:text-marca transition-colors") #{producto.nombre}
                    p(class="text-sm text-slate-500 mt-1") $#{item.precioUnitario.toLocaleString('es-AR')} c/u
                    if producto.tipo === 'fisico'
                      p(class="text-xs text-slate-400 mt-1") Stock disponible: #{producto.stock}

                  div(class="sm:w-56 flex sm:flex-col gap-3 sm:items-end")
                    form(action="/tienda/" + tienda._id + "/carrito/actualizar/" + producto._id method="POST" class="flex items-center gap-2")
                      input(type="number" name="cantidad" value=item.cantidad min="1" max=(producto.tipo === 'fisico' ? producto.stock : 99) class="w-20 border border-slate-300 rounded-xl px-3 py-2 text-sm")
                      button(type="submit" class="bg-slate-950 text-white text-xs font-bold px-3 py-2 rounded-xl hover:bg-slate-800") Actualizar
                    p(class="font-extrabold text-slate-950") $#{item.subtotal.toLocaleString('es-AR')}
                    form(action="/tienda/" + tienda._id + "/carrito/quitar/" + producto._id method="POST")
                      button(type="submit" class="text-xs font-bold text-red-500 hover:text-red-700") Quitar

        aside(class="surface border border-white rounded-3xl p-6 h-fit")
          h2(class="text-xl font-extrabold text-slate-950") Resumen de compra
          div(class="mt-5 space-y-3 text-sm")
            div(class="flex justify-between text-slate-500")
              span Items
              span #{cantidadTotal}
            div(class="flex justify-between text-slate-500")
              span Envio
              span A definir
            div(class="border-t border-slate-100 pt-4 flex justify-between items-baseline")
              span(class="font-bold text-slate-900") Total
              span(class="text-3xl font-extrabold text-slate-950") $#{total.toLocaleString('es-AR')}

          if items.length > 0
            div(class="mt-6 space-y-3")
              button(type="button" onclick="abrirPago('MercadoPago')" class="w-full text-left border border-sky-100 bg-sky-50 hover:bg-sky-100 rounded-2xl px-4 py-3 transition-colors")
                p(class="font-extrabold text-sky-700") Pagar con MercadoPago
                p(class="text-xs text-sky-600 mt-0.5") Opcion visual para la demo
              button(type="button" onclick="abrirPago('Transferencia bancaria')" class="w-full text-left border border-slate-200 bg-white hover:bg-slate-50 rounded-2xl px-4 py-3 transition-colors")
                p(class="font-extrabold text-slate-900") Pagar por transferencia
                p(class="text-xs text-slate-500 mt-0.5") Simulacion sin generar orden real
              button(type="button" onclick="abrirPago('tarjeta de credito/debito')" class="w-full text-left border border-blue-100 bg-blue-50 hover:bg-blue-100 rounded-2xl px-4 py-3 transition-colors")
                p(class="font-extrabold text-blue-700") Pagar con tarjeta
                p(class="text-xs text-blue-600 mt-0.5") Checkout preparado para la presentacion
            if previsualizando
              p(class="text-xs text-slate-400 mt-4 leading-relaxed") Pago simulado para presentacion. No procesa dinero ni genera orden real.
          else
            a(href="/tienda/" + tienda._id class="mt-6 w-full inline-flex justify-center btn-marca text-white font-bold py-3 rounded-xl text-sm transition-all") Volver al catalogo

    div#modal-pago(class="fixed inset-0 bg-slate-950/60 hidden items-center justify-center p-4 z-50")
      div(class="bg-white rounded-3xl shadow-2xl max-w-md w-full p-6")
        div(class="flex items-start justify-between gap-4")
          div
            p(class="text-xs font-bold text-marca uppercase tracking-wide") Checkout simulado
            h3(class="text-xl font-extrabold text-slate-950 mt-1") Metodo de pago
          button(type="button" onclick="cerrarPago()" class="text-slate-400 hover:text-slate-700 text-2xl leading-none") x

        div(class="mt-5 border border-blue-100 bg-blue-50 rounded-2xl p-4")
          p#modal-metodo(class="font-extrabold text-blue-900") Metodo seleccionado
          p(class="text-sm text-blue-800 mt-1") Esta opcion queda preparada visualmente para la demo. La integracion real de pagos se implementaria en una etapa posterior.

        div(class="mt-5 rounded-2xl border border-slate-200 p-4")
          p(class="text-sm font-bold text-slate-900") Total a pagar
          p(class="text-3xl font-extrabold text-slate-950 mt-1") $#{total.toLocaleString('es-AR')}
          p(class="text-xs text-slate-400 mt-2") No se guardan datos de tarjeta ni se contacta a pasarelas externas.

        button(type="button" onclick="cerrarPago()" class="mt-6 w-full bg-slate-950 hover:bg-slate-800 text-white font-bold py-3 rounded-xl text-sm") Entendido

    script.
      function abrirPago(metodo) {
        document.getElementById('modal-metodo').textContent = 'Pagar con ' + metodo;
        var modal = document.getElementById('modal-pago');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }

      function cerrarPago() {
        var modal = document.getElementById('modal-pago');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
