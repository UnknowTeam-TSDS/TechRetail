doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title TechRetail Solutions — Mis Pedidos
    script(src="https://cdn.tailwindcss.com")
    link(rel="manifest" href="/manifest.json")
    meta(name="theme-color" content="#1D4ED8")
    link(rel="apple-touch-icon" href="/icons/icon-192.png")
    script(src="/js/pwa.js")
  body(class="bg-slate-100 min-h-screen font-sans text-slate-900")

    //- Helper: traduce el id de un medio a su nombre legible usando el catálogo.
    -
      function nombreMedio(catalogo, id) {
        var opcion = catalogo.find(function(o) { return o.id === id; });
        return opcion ? opcion.nombre : id;
      }

    header(class="bg-blue-900 text-white")
      div(class="max-w-5xl mx-auto px-5 py-8")
        a(href="/mi-tienda" class="text-blue-200 hover:text-white text-sm") ← Volver a mi tienda
        div(class="mt-6 flex flex-col md:flex-row md:items-end md:justify-between gap-4")
          div
            p(class="text-blue-200 text-sm font-medium") Pedidos recibidos
            h1(class="text-3xl font-extrabold mt-1") #{tienda.nombre}
            p(class="text-blue-100 text-sm mt-2 max-w-xl") Cada pedido es una compra simulada desde tu tienda pública. No se procesó dinero real.
          div(class="flex gap-3")
            div(class="bg-white/10 border border-white/15 rounded-xl px-4 py-3")
              p(class="text-xs text-blue-200 uppercase font-bold tracking-wide") Pedidos
              p(class="text-3xl font-extrabold") #{pedidos.length}
            div(class="bg-white/10 border border-white/15 rounded-xl px-4 py-3")
              p(class="text-xs text-blue-200 uppercase font-bold tracking-wide") Total simulado
              p(class="text-3xl font-extrabold") $#{totalVendido.toLocaleString('es-AR')}

    main(class="max-w-5xl mx-auto px-5 py-8")
      if flash
        - var esError = flash.tipo === 'error'
        div(class="rounded-xl px-4 py-3 mb-6 text-sm font-semibold " + (esError ? 'bg-red-50 border border-red-200 text-red-700' : 'bg-green-50 border border-green-200 text-green-700'))
          | #{flash.mensaje}

      if pedidos.length === 0
        div(class="bg-white rounded-2xl shadow-sm border border-slate-200 text-center px-6 py-16")
          div(class="w-14 h-14 rounded-2xl bg-slate-100 mx-auto mb-4 flex items-center justify-center text-slate-400 font-extrabold text-xl") 0
          p(class="text-xl font-extrabold text-slate-900") Todavía no recibiste pedidos
          p(class="text-slate-500 text-sm mt-2 max-w-sm mx-auto") Cuando un cliente complete el checkout en tu tienda, el pedido va a aparecer acá.
          a(href="/tienda/" + tienda._id target="_blank" class="inline-flex mt-6 bg-blue-900 hover:bg-blue-800 text-white font-bold px-5 py-2.5 rounded-xl text-sm transition-colors") Ver mi tienda →
      else
        div(class="space-y-4")
          each pedido in pedidos
            div(class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden")
              div(class="px-5 py-4 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3")
                div
                  p(class="font-extrabold text-slate-900") Pedido ##{pedido._id.toString().slice(-8).toUpperCase()}
                  p(class="text-xs text-slate-400 mt-0.5") #{new Date(pedido.createdAt).toLocaleString('es-AR')}
                div(class="flex items-center gap-2")
                  span(class="bg-blue-50 text-blue-700 text-xs font-bold px-3 py-1.5 rounded-full capitalize") #{pedido.estado}
                  span(class="text-lg font-extrabold text-slate-950") $#{pedido.total.toLocaleString('es-AR')}

              div(class="px-5 py-4 grid grid-cols-1 md:grid-cols-3 gap-4")
                div
                  p(class="text-xs text-slate-400 font-bold uppercase tracking-wide mb-1") Comprador
                  p(class="text-sm font-semibold text-slate-800") #{pedido.comprador.nombre}
                  p(class="text-xs text-slate-500") #{pedido.comprador.email}
                  if pedido.comprador.telefono
                    p(class="text-xs text-slate-500") #{pedido.comprador.telefono}
                div
                  p(class="text-xs text-slate-400 font-bold uppercase tracking-wide mb-1") Pago / Envío
                  p(class="text-sm font-semibold text-slate-800") #{nombreMedio(MEDIOS_PAGO, pedido.medioPago)}
                  p(class="text-xs text-slate-500")
                    if pedido.medioEnvio
                      | #{nombreMedio(MEDIOS_ENVIO, pedido.medioEnvio)}
                    else
                      | Envío a coordinar
                div
                  p(class="text-xs text-slate-400 font-bold uppercase tracking-wide mb-1") Productos
                  each item in pedido.items
                    p(class="text-sm text-slate-700") #{item.cantidad} × #{item.nombre}

    p(class="text-center text-slate-400 text-xs py-6") © 2025 TechRetail Solutions S.R.L.
