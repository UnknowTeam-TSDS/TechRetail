doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Pedido confirmado - #{tienda.nombre}
    script(src="https://cdn.tailwindcss.com")
    link(rel="manifest" href="/manifest.json")
    meta(name="theme-color" content="#1D4ED8")
    style.
      :root { --color-marca: #{tienda.colorPrimario}; }
      .bg-marca { background-color: var(--color-marca); }
      .text-marca { color: var(--color-marca); }
      .btn-marca { background-color: var(--color-marca); }
      .btn-marca:hover { filter: brightness(.94); }
      .store-bg {
        background:
          radial-gradient(circle at top left, rgba(29, 78, 216, .12), transparent 30rem),
          linear-gradient(180deg, #f8fafc 0%, #eef3f8 100%);
      }
      .surface { background: rgba(255, 255, 255, .92); box-shadow: 0 18px 45px rgba(15, 23, 42, .07); }

  body(class="store-bg min-h-screen font-sans text-slate-900 px-5 py-10")
    main(class="max-w-2xl mx-auto")

      section(class="surface rounded-3xl border border-white overflow-hidden")
        div(class="bg-marca px-7 py-8 text-white text-center")
          div(class="w-14 h-14 rounded-2xl bg-white/20 mx-auto flex items-center justify-center text-3xl mb-3") ✓
          h1(class="text-2xl font-extrabold") ¡Pedido registrado!
          p(class="text-white/85 text-sm mt-1") Gracias por tu compra en #{tienda.nombre}

        div(class="p-7")
          //- Aclaración del alcance: el pago es simulado, no se cobró dinero.
          div(class="bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 mb-6")
            p(class="text-sm text-amber-800 font-semibold") Compra simulada
            p(class="text-xs text-amber-700 mt-0.5") Este es un checkout de demostración: no se procesó ningún pago real ni se generó una orden de envío.

          div(class="flex flex-wrap items-center justify-between gap-2 mb-5")
            div
              p(class="text-xs text-slate-400 uppercase font-bold tracking-wide") Número de pedido
              p(class="font-extrabold text-slate-900") ##{pedido._id.toString().slice(-8).toUpperCase()}
            span(class="bg-blue-50 text-blue-700 text-xs font-bold px-3 py-1.5 rounded-full capitalize") #{pedido.estado}

          div(class="border border-slate-200 rounded-2xl divide-y divide-slate-100 mb-5")
            each item in pedido.items
              div(class="flex items-center justify-between gap-4 px-4 py-3")
                div(class="min-w-0")
                  p(class="text-sm font-semibold text-slate-800 truncate") #{item.nombre}
                  p(class="text-xs text-slate-400") #{item.cantidad} × $#{item.precioUnitario.toLocaleString('es-AR')}
                p(class="text-sm font-bold text-slate-900 shrink-0") $#{item.subtotal.toLocaleString('es-AR')}
            div(class="flex items-center justify-between gap-4 px-4 py-3 bg-slate-50")
              span(class="font-bold text-slate-900") Total
              span(class="text-xl font-extrabold text-slate-950") $#{pedido.total.toLocaleString('es-AR')}

          dl(class="grid grid-cols-2 gap-3 text-sm")
            div(class="bg-slate-50 rounded-xl p-3")
              dt(class="text-xs text-slate-400 font-bold uppercase tracking-wide") Pago
              dd(class="font-semibold text-slate-800 mt-0.5") #{medioPagoNombre}
            if medioEnvioNombre
              div(class="bg-slate-50 rounded-xl p-3")
                dt(class="text-xs text-slate-400 font-bold uppercase tracking-wide") Envío
                dd(class="font-semibold text-slate-800 mt-0.5") #{medioEnvioNombre}
            div(class="bg-slate-50 rounded-xl p-3 col-span-2")
              dt(class="text-xs text-slate-400 font-bold uppercase tracking-wide") Comprador
              dd(class="font-semibold text-slate-800 mt-0.5") #{pedido.comprador.nombre} — #{pedido.comprador.email}

          a(href="/tienda/" + tienda._id class="block text-center mt-7 btn-marca text-white font-bold py-3 rounded-xl text-sm transition-all") Volver a la tienda

      p(class="text-center text-xs text-slate-400 mt-6")
        | Plataforma
        span(class="text-slate-500 ml-1") TechRetail Solutions
