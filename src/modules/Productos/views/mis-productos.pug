doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title TechRetail Solutions — Mis Productos
    script(src="https://cdn.tailwindcss.com")
  body(class="bg-gradient-to-br from-blue-900 to-blue-700 min-h-screen font-sans py-10 px-4")

    div(class="max-w-4xl mx-auto")

      div(class="text-center mb-6")
        h1(class="text-2xl font-bold text-white") TechRetail Solutions
        div(class="flex items-center justify-center gap-2 mt-1")
          div(class="w-3 h-3 rounded-full" style=`background-color:${tienda.colorPrimario}`)
          p(class="text-blue-200 text-sm") #{tienda.nombre}

      div(class="bg-white rounded-2xl shadow-2xl p-6 mb-6")
        h3(class="text-base font-bold text-blue-900 mb-4") Agregar producto
        form(action="/mis-productos/form" method="POST")
          div(class="grid grid-cols-1 md:grid-cols-2 gap-4")
            div
              label(class="block text-sm text-gray-600 mb-1") Nombre
              input(type="text" name="nombre" required minlength="3" placeholder="Ej: Remera básica negra" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")
            div
              label(class="block text-sm text-gray-600 mb-1") Categoría
              input(type="text" name="categoria" placeholder="Ej: Indumentaria" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")
            div
              label(class="block text-sm text-gray-600 mb-1") Precio (ARS)
              input(type="number" name="precio" required min="0" step="0.01" placeholder="0.00" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")
            div
              label(class="block text-sm text-gray-600 mb-1") Stock
              input(type="number" name="stock" min="0" placeholder="0" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400")
            div(class="md:col-span-2")
              label(class="block text-sm text-gray-600 mb-1") Descripción
              textarea(name="descripcion" rows="2" placeholder="Descripción breve del producto" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400 resize-none")
            div
              button(type="submit" class="mt-2 bg-blue-900 text-white px-5 py-2 rounded-lg text-sm font-semibold hover:bg-blue-800 transition-colors") + Agregar producto

      div(class="bg-white rounded-2xl shadow-2xl overflow-hidden")
        if productos.length === 0
          div(class="p-10 text-center")
            p(class="text-gray-400 text-sm") No tenés productos cargados todavía.
            p(class="text-gray-300 text-xs mt-1") Usá el formulario de arriba para agregar tu primer producto.
        else
          table(class="w-full border-collapse")
            thead
              tr
                th(class="bg-blue-900 text-white text-left text-sm px-4 py-3") Nombre
                th(class="bg-blue-900 text-white text-left text-sm px-4 py-3") Categoría
                th(class="bg-blue-900 text-white text-left text-sm px-4 py-3") Precio
                th(class="bg-blue-900 text-white text-left text-sm px-4 py-3") Stock
                th(class="bg-blue-900 text-white text-left text-sm px-4 py-3") Estado
                th(class="bg-blue-900 text-white text-left text-sm px-4 py-3") Acciones
            tbody
              each producto in productos
                tr(class="border-b border-gray-100 hover:bg-blue-50 transition-colors")
                  td(class="px-4 py-3")
                    p(class="text-sm font-medium text-gray-900") #{producto.nombre}
                    if producto.descripcion
                      p(class="text-xs text-gray-400 mt-0.5 truncate max-w-xs") #{producto.descripcion}
                  td(class="px-4 py-3 text-sm text-gray-500") #{producto.categoria || '—'}
                  td(class="px-4 py-3 text-sm font-semibold text-blue-900") $#{producto.precio.toLocaleString('es-AR')}
                  td(class="px-4 py-3 text-sm text-gray-700") #{producto.stock}
                  td(class="px-4 py-3")
                    if producto.activo
                      span(class="inline-block bg-green-100 text-green-800 text-xs font-semibold px-2 py-0.5 rounded-full") Activo
                    else
                      span(class="inline-block bg-gray-100 text-gray-500 text-xs font-semibold px-2 py-0.5 rounded-full") Inactivo
                  td(class="px-4 py-3")
                    div(class="flex gap-2")
                      form(action="/mis-productos/estado/" + producto._id method="POST")
                        input(type="hidden" name="activo" value=producto.activo ? 'false' : 'true')
                        button(type="submit" class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs font-semibold hover:bg-blue-200 transition-colors")
                          if producto.activo
                            | Desactivar
                          else
                            | Activar
                      form(action="/mis-productos/eliminar/" + producto._id method="POST" onsubmit="return confirm('¿Eliminar este producto?')")
                        button(type="submit" class="bg-red-100 text-red-700 px-2 py-1 rounded text-xs font-semibold hover:bg-red-200 transition-colors") Eliminar

      div(class="text-center mt-4")
        a(href="/mi-tienda" class="text-blue-200 text-sm hover:text-white") ← Volver a mi tienda

    p(class="text-center text-blue-200 text-xs mt-6 mb-4") © 2025 TechRetail Solutions S.R.L.
